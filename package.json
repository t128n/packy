{
	"name": "packy",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"prepare:coi": "bun run scripts/copy-coi-serviceworker.ts",
		"build": "bun run prepare:coi && svelte-check --tsconfig ./tsconfig.json && vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"update": "taze",
		"preview": "vite preview",
		"fmt": "oxfmt .",
		"lint:fix": "oxlint . --fix",
		"test": "bun run --parallel test:fmt test:lint test:knip test:typecheck test:unit",
		"test:fmt": "oxfmt . --check",
		"test:lint": "oxlint .",
		"test:knip": "knip",
		"test:typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "bun test src",
		"test:browser": "playwright test"
	},
	"dependencies": {
		"@t128n/ui": "0.1.1",
		"@webcontainer/api": "^1.6.1",
		"coi-serviceworker": "^0.1.7",
		"ofetch": "^1.5.1",
		"semver": "^7.8.5",
		"svelte": "^5.57.3"
	},
	"devDependencies": {
		"@e18e/eslint-plugin": "^0.3.0",
		"@iconify-json/carbon": "^1.2.29",
		"@playwright/test": "^1.56.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.4",
		"@types/node": "^25.6.0",
		"@types/semver": "^7.8.0",
		"knip": "^6.3.1",
		"oxfmt": "^0.44.0",
		"oxlint": "^1.59.0",
		"svelte-check": "^4.7.7",
		"taze": "^19.11.0",
		"typescript": "^6.0.2",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.0.8"
	},
	"packageManager": "bun@1.4.3"
}
